[Unit]
Description=Dash local drive library and PWA
After=local-fs.target network.target
RequiresMountsFor=/data
StartLimitIntervalSec=300
StartLimitBurst=3
ConditionPathIsDirectory=/data/media/0/realdata

[Service]
Type=simple
User=comma
Group=comma
WorkingDirectory=/data/dash
Environment=DASH_TLS_ARGS= DASH_EXTRA_ARGS=
EnvironmentFile=-/data/dash/dash.env
ExecStart=/data/dash/dash-bootstrap --supervise --update-home /data/dash --listen 0.0.0.0:8088 --root /data/media/0/realdata --cache /data/dash/cache --app /data/dash/current/dist --params /data/params/d --firmware /data/openpilot --device $DASH_TLS_ARGS $DASH_EXTRA_ARGS
ExecStopPost=/data/dash/dash-bootstrap --stop-live --cache /data/dash/cache --params /data/params/d
Restart=on-failure
RestartSec=10
TimeoutStopSec=5
KillMode=control-group
KillSignal=SIGTERM
SendSIGKILL=yes
OOMPolicy=stop
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dash-backend
UMask=0077
CPUAccounting=yes
MemoryAccounting=yes
MemoryHigh=256M
MemoryMax=384M
MemorySwapMax=0
TasksAccounting=yes
TasksMax=128
LimitNOFILE=1024
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ReadWritePaths=/data/dash /data/params
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
