{
  "name": "dash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @dash/frontend",
    "build": "npm run build --workspace @dash/frontend",
    "preview": "npm run preview --workspace @dash/frontend",
    "test": "vitest run --config vitest.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "prettier": "^3.6.0",
    "vitest": "^5.0.4",
    "yaml": "^2.9.1"
  }
}
